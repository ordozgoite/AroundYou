    "If the community is private, users must request to join it — and you’ll need to approve their request before they can enter." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a comunidade for privada, os usuários devem solicitar a entrada nela — e você precisará aprovar a solicitação antes que eles possam entrar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a comunidade for privada, os utilizadores têm de pedir para participar — e terá de aprovar o pedido antes de poderem entrar."
          }
        }
      }
    },
    "If this option is enabled, we will notify you whenever we find someone matching your interests nearby." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esta opção estiver habilitada, nós o notificaremos sempre que encontrarmos alguém que corresponda aos seus interesses nas proximidades."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esta opção estiver ativa, iremos notificá-lo sempre que encontrarmos por perto alguém que corresponda aos seus interesses."
          }
        }
      }
    },
    "If you quit this screen, you will lose your changes." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você sair dessa tela, você vai perder suas mudanças."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você sair dessa tela, você vai perder suas mudanças."
          }
        }
      }
    },
    "If you want to leave this community, tap and hold it." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você quiser deixar essa comunidade, aperte e segura no seu ícone."
