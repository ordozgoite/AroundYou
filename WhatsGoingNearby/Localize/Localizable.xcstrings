    "AroundYou displays posts to everybody within a **1km radius**, enabling interaction for making friends, asking for help, and getting information about places and events around you." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AroundYou mostra publicações para todos em um raio de **1km**, permitindo interação para fazer amigos, pedir ajuda e obter informações sobre lugares e eventos ao seu redor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AroundYou mostra publicações para todos em um raio de **1km**, permitindo interação para fazer amigos, pedir ajuda e obter informações sobre lugares e eventos ao seu redor."
          }
        }
      }
    },
    "AroundYou uses your location to show posts only to those nearby, ensuring that you connect with people and events in your immediate vicinity." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AroundYou usa sua localização para mostrar publicações apenas para aqueles que estão por perto, para que você se conecte com pessoas e eventos na sua vizinhança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AroundYou usa a sua localização para mostrar publicações apenas a quem está por perto, para que se ligue a pessoas e eventos na sua vizinhança."
          }
        }
      }
    },
    "AroundYou uses your location, displaying posts exclusively to those within a **1km radius**, ensuring you connect with nearby people and events." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ArondYou usa a sua localização para exibir apenas publicações que estão em um **raio de 1km**. Dessa forma você se conecta apenas com pessoas e eventos próximos de você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AroundYou usa a sua localização e mostra publicações exclusivamente a quem está num **raio de 1 km**. Assim, liga-se apenas a pessoas e eventos perto de si."
          }
        }
      }
    },
